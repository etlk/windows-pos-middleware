<UserControl x:Class="MiddlewareApp.Views.PrinterConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <!-- CENTERED CONTENT -->
        <StackPanel Margin="20"
                    MaxWidth="600"
                    HorizontalAlignment="Center">

            <!-- Logo -->
            <Image Source="../Assets/logo.png"
                   Width="120"
                   Height="60"
                   Margin="0,0,0,5"
                   HorizontalAlignment="Left"/>

            <!-- Status -->
            <TextBlock Text="● Middleware Connected"
                       Foreground="Green"
                       Margin="0,0,0,10"/>

            <!-- Breadcrumb -->
            <TextBlock Foreground="Gray"
           Margin="0,0,0,20"
           Text="{Binding BreadcrumbText}" />

            <!-- Terminal Printer -->
            <TextBlock Text="{Binding Terminal}"
                       FontWeight="Bold"
                       FontSize="16"/>

            <TextBlock Text="Configure a printer to send the full receipt for orders done at this terminal."
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,5,0,10"/>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,0,20">

                <StackPanel>
                    <ComboBox x:Name="PrinterComboBox"
                              Height="40"
                              Margin="0,0,0,10"
                              Padding="5"
                              FontSize="14"/>

                    <Button Content="Configure"
                            Height="40"
                            x:Name="TerminalConfigureButton"
                            Background="#2D6CDF"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="TerminalConfigure_Click"/>
                </StackPanel>
            </Border>

            <!-- Departments -->
            <TextBlock Text="Departments"
                       FontWeight="Bold"
                       FontSize="16"/>

            <TextBlock Text="Configure printer to each department to send the receipts."
                       Foreground="Gray"
                       Margin="0,5,0,10"/>

           <StackPanel x:Name="DepartmentsPanel"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>