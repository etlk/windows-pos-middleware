<UserControl x:Class="MiddlewareApp.Views.BusinessCodeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MiddlewareApp.Views.Controls"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: branding -->
        <StackPanel VerticalAlignment="Center" Margin="40,20">
            <Image Source="pack://application:,,,/Assets/brand.png"
                   Width="180" Height="60" Stretch="Uniform"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Style="{StaticResource Greeting}" Text="Good Afternoon!"/>
            <TextBlock Style="{StaticResource GreetingSub}" Margin="0,8,0,0"
                       Text="Please enter your business code to get started!"/>
        </StackPanel>

        <!-- Right: form -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Margin="40,20" MaxWidth="420">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,8"
                           Text="BUSINESS CODE"/>
                <Grid>
                    <PasswordBox x:Name="CodeBox" Style="{StaticResource PasswordInput}"
                                 PasswordChanged="CodeBox_PasswordChanged"/>
                    <TextBlock x:Name="CodeHint" Text="Enter your business code here"
                               FontSize="15" Foreground="{StaticResource TextDimBrush}"
                               Margin="17,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>

                <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}"
                        Margin="0,16,0,0" Click="Continue_Click" IsDefault="True">
                    <Grid>
                        <TextBlock x:Name="ContinueLabel" Text="Continue"/>
                        <controls:Spinner x:Name="ContinueSpinner" Width="18" Height="18"
                                          Color="White" Visibility="Collapsed"/>
                    </Grid>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
