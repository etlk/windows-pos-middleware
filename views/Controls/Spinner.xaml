<UserControl x:Class="MiddlewareApp.Views.Controls.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20">
    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="Rotation"/>
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="Rotation"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:0.9"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Ellipse x:Name="Ring" StrokeThickness="3" StrokeDashCap="Round"
                 Stroke="{StaticResource PrimaryBrush}" Opacity="0.25"/>
        <Ellipse x:Name="Arc" StrokeThickness="3" StrokeDashCap="Round"
                 Stroke="{StaticResource PrimaryBrush}" StrokeDashArray="8 100"/>
    </Grid>
</UserControl>
