<UserControl x:Class="MiddlewareApp.Views.Controls.ConfigCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MiddlewareApp.Views.Controls">
    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
            <!-- Header: title + status pill -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border x:Name="Badge" Grid.Column="1" CornerRadius="20" Padding="10,4"
                        Background="{StaticResource FaintBgBrush}">
                    <TextBlock x:Name="BadgeText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Text="Not set"/>
                </Border>
            </Grid>

            <!-- Assigned printer inset box -->
            <Border x:Name="AssignedBox" Visibility="Collapsed" Margin="0,12,0,0"
                    Background="{StaticResource BgBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Assigned printer" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="AssignedIpText" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="AssignedPaperText" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    <Button x:Name="RemoveButton" Style="{StaticResource OutlineDangerButton}"
                            Content="Remove printer" Margin="0,10,0,0" Click="Remove_Click"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="NoPrinterText" Text="No printer assigned yet."
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,10,0,0"/>

            <!-- Printer picker -->
            <TextBlock x:Name="SelectLabel" Style="{StaticResource FieldLabel}"
                       Text="Select printer" Margin="0,16,0,6"/>

            <StackPanel x:Name="ScanStatusPanel" Orientation="Horizontal" Visibility="Collapsed"
                        Margin="0,2,0,4">
                <controls:Spinner Width="14" Height="14"/>
                <TextBlock x:Name="ScanStatusText" FontSize="12" Margin="8,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="Scanning for printers…" VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer x:Name="ChipsScroll" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel x:Name="ChipsPanel" Orientation="Horizontal"/>
            </ScrollViewer>

            <TextBlock x:Name="NoneFoundText" Visibility="Collapsed" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Text="No printers found on network. Enter IP manually below or tap Re-scan."/>

            <!-- Manual IP row -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Manual IP (if scan fails)"
                       Margin="0,14,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ManualIpBox" Style="{StaticResource InputBox}"
                         Tag="192.168.1.100" FontSize="14" Padding="12,10"/>
                <TextBox x:Name="ManualPortBox" Grid.Column="1" Style="{StaticResource InputBox}"
                         Tag="9100" FontSize="14" Padding="8,10" Width="72"
                         Margin="8,0,0,0" TextAlignment="Center"/>
            </Grid>
            <Button x:Name="UseIpButton" Style="{StaticResource LinkButton}" Content="Use this IP"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="UseIp_Click"/>

            <!-- Save -->
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                    Margin="0,16,0,0" Click="Save_Click">
                <Grid>
                    <TextBlock x:Name="SaveLabel" Text="Save printer"/>
                    <controls:Spinner x:Name="SaveSpinner" Width="18" Height="18"
                                      Color="White" Visibility="Collapsed"/>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
