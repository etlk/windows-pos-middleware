<UserControl x:Class="MiddlewareApp.Views.DeviceScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: branding -->
        <StackPanel VerticalAlignment="Center" Margin="40,20">
            <Image Source="pack://application:,,,/Assets/brand.png"
                   Width="180" Height="60" Stretch="Uniform"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Style="{StaticResource Greeting}" Text="Good Afternoon!"/>
            <TextBlock Style="{StaticResource GreetingSub}" Margin="0,8,0,0"
                       Text="Please select your device to continue ›"/>
        </StackPanel>

        <!-- Right: device list -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30" MaxWidth="420">
                <StackPanel x:Name="ListPanel"/>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed"
                           Style="{StaticResource GreetingSub}" Margin="0,20,0,0"
                           Text="No devices found at this branch."/>
                <Button Style="{StaticResource BackButton}" Content="‹ Back"
                        Margin="0,16,0,0" Click="Back_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
