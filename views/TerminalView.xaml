<UserControl x:Class="MiddlewareApp.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <Grid>
        <StackPanel Width="350"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
    <Image Source="../Assets/logo.png"
           Width="200"
           Height="80"
          Margin="0,0,0,5"
           HorizontalAlignment="Center"/>
            <!-- Title -->
            <TextBlock x:Name="GreetingText"
               FontSize="20"
                FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                      Margin="0,0,0,10"/>

            <TextBlock Text="please select your device to continue >"
                       FontSize="12"
                       Foreground="Gray"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Terminal List -->
            <StackPanel x:Name="TerminalListPanel"/>

        </StackPanel>
    </Grid>
</UserControl>