<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>Cloud POS Middleware</AssemblyName>
    <AssemblyTitle>Cloud POS Middleware</AssemblyTitle>
    <Product>Cloud POS Middleware</Product>
  </PropertyGroup>

  <!-- WinForms is referenced only for NotifyIcon; keep its namespace out of the
       global usings so WPF types stay unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Sibling projects live under the same root; keep them out of this project's globs. -->
  <ItemGroup>
    <Compile Remove="MiddlewareApp.Core\**;MiddlewareApp.Core.Tests\**;docs\**" />
    <Page Remove="MiddlewareApp.Core\**;MiddlewareApp.Core.Tests\**;docs\**" />
    <None Remove="MiddlewareApp.Core\**;MiddlewareApp.Core.Tests\**;docs\**" />
    <Content Remove="MiddlewareApp.Core\**;MiddlewareApp.Core.Tests\**;docs\**" />
    <Resource Remove="MiddlewareApp.Core\**;MiddlewareApp.Core.Tests\**;docs\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\brand.png" />
    <Resource Include="Assets\tray-icon.png" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="MiddlewareApp.Core\MiddlewareApp.Core.csproj" />
  </ItemGroup>

</Project>
